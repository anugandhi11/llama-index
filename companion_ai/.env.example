# Copy this file to .env and fill in the values you need, then:
#   python -m companion_ai.main

# --- Choose ONE cloud LLM provider (all have generous free tiers) ---
LLM_PROVIDER=gemini              # gemini | groq | openai_compatible

# Google AI Studio (free): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (free, extremely low latency): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Any other OpenAI-compatible endpoint (LM Studio, OpenRouter, vLLM, etc.)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

LLM_TEMPERATURE=0.9
LLM_MAX_OUTPUT_TOKENS=512
LLM_REQUEST_TIMEOUT=30

# --- Companion identity ---
COMPANION_NAME=Atlas
USER_NAME=you

# --- Local GPU voice engine ---
DEVICE=auto                      # auto | cuda | cpu
WHISPER_MODEL_SIZE=small.en      # tiny.en | base.en | small.en | distil-large-v3 ...
WHISPER_COMPUTE_TYPE=float16     # float16 on GPU, int8 on CPU (auto-adjusted)
TTS_VOICE=af_heart
TTS_SPEED=1.0
# INPUT_DEVICE=                  # index from `python -m companion_ai.main --list-audio-devices`
# OUTPUT_DEVICE=
SILENCE_THRESHOLD=0.012
SILENCE_DURATION_S=1.1
MAX_UTTERANCE_S=30

# --- Memory ---
MEMORY_DIR=~/.companion_ai/memory
MAX_HISTORY_TURNS=12
MEMORY_TOP_K=4
MEMORY_RELEVANCE_THRESHOLD=0.35
